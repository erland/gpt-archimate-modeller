{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "new_project"
  ],
  "additionalProperties": false,
  "properties": {
    "new_project": {
      "type": "object",
      "required": [
        "id",
        "name"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string"
        },
        "language": {
          "type": "string",
          "default": "sv"
        },
        "model_version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
          "default": "0.1.0"
        },
        "archimate_version": {
          "type": "string",
          "enum": [
            "3.2"
          ],
          "default": "3.2"
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "profiles": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "include_standard_extensions": {
              "type": "boolean",
              "default": true
            },
            "include_standard_specializations": {
              "type": "boolean",
              "default": true
            }
          }
        },
        "seed": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "elements": {
              "type": "array",
              "items": {
                "type": "object"
              }
            },
            "relationships": {
              "type": "array",
              "items": {
                "type": "object"
              }
            },
            "sources": {
              "type": "array",
              "items": {
                "type": "object"
              }
            },
            "references": {
              "type": "array",
              "items": {
                "type": "object"
              }
            }
          }
        }
      }
    }
  }
}