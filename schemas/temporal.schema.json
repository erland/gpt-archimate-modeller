{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "valid_from": {
      "type": "string",
      "format": "date"
    },
    "valid_to": {
      "type": "string",
      "format": "date"
    },
    "planned_from": {
      "type": "string",
      "format": "date"
    },
    "planned_to": {
      "type": "string",
      "format": "date"
    },
    "retired_on": {
      "type": "string",
      "format": "date"
    },
    "as_of": {
      "type": "string",
      "format": "date"
    },
    "status_source": {
      "type": "string",
      "enum": [
        "actual",
        "planned",
        "inferred",
        "unknown"
      ]
    },
    "note": {
      "type": "string"
    }
  }
}