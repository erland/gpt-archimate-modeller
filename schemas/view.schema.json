{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/view.schema.json",
  "title": "EA View",
  "type": "object",
  "required": [
    "view"
  ],
  "additionalProperties": false,
  "properties": {
    "view": {
      "type": "object",
      "required": [
        "id",
        "title",
        "source"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string"
        },
        "source": {
          "$ref": "#/$defs/source"
        },
        "include_relationships": {
          "type": "string",
          "enum": [
            "between_selected",
            "all_touching_selected",
            "none"
          ],
          "default": "between_selected"
        },
        "include_elements": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "exclude_elements": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "exclude_relationships": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "layout": {
          "$ref": "#/$defs/layout"
        },
        "groups": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/group"
          }
        },
        "nodes": {
          "$ref": "#/$defs/nodes"
        },
        "edges": {
          "$ref": "#/$defs/edges"
        },
        "style": {
          "type": "object"
        }
      }
    }
  },
  "$defs": {
    "source": {
      "type": "object",
      "required": [
        "query"
      ],
      "additionalProperties": false,
      "properties": {
        "query": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "layout": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "direction": {
          "type": "string",
          "enum": [
            "left_to_right",
            "top_to_bottom",
            "right_to_left",
            "bottom_to_top"
          ]
        },
        "algorithm": {
          "type": "string",
          "enum": [
            "layered",
            "grid",
            "manual",
            "auto"
          ]
        },
        "rank_by": {
          "type": "string"
        }
      }
    },
    "group": {
      "type": "object",
      "required": [
        "id",
        "title",
        "match"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "match": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "types": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "specializations": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "ids": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "nodes": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "label": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "primary": {
              "type": "string"
            },
            "secondary": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "show_properties": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "edges": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "show_type": {
          "type": "boolean"
        },
        "show_name": {
          "type": "boolean"
        },
        "show_confidence": {
          "type": "boolean"
        }
      }
    }
  }
}