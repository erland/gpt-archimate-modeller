{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/report.schema.json",
  "title": "EA Report",
  "type": "object",
  "required": [
    "report"
  ],
  "additionalProperties": false,
  "properties": {
    "report": {
      "type": "object",
      "required": [
        "id",
        "title",
        "sections"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string"
        },
        "metadata": {
          "type": "object"
        },
        "sections": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/section"
          }
        }
      }
    }
  },
  "$defs": {
    "source": {
      "type": "object",
      "required": [
        "query"
      ],
      "additionalProperties": false,
      "properties": {
        "query": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "column": {
      "type": "object",
      "required": [
        "field",
        "heading"
      ],
      "additionalProperties": false,
      "properties": {
        "field": {
          "type": "string",
          "minLength": 1
        },
        "heading": {
          "type": "string",
          "minLength": 1
        },
        "default": {},
        "format": {
          "type": "string",
          "enum": [
            "text",
            "code",
            "boolean",
            "date"
          ]
        }
      }
    },
    "render": {
      "type": "object",
      "required": [
        "type"
      ],
      "additionalProperties": false,
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "table",
            "list",
            "summary"
          ]
        },
        "columns": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/column"
          }
        },
        "item_fields": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "group_by": {
      "type": "object",
      "required": [
        "field"
      ],
      "additionalProperties": false,
      "properties": {
        "field": {
          "type": "string"
        }
      }
    },
    "sort": {
      "type": "object",
      "required": [
        "field"
      ],
      "additionalProperties": false,
      "properties": {
        "field": {
          "type": "string"
        },
        "direction": {
          "type": "string",
          "enum": [
            "asc",
            "desc"
          ],
          "default": "asc"
        }
      }
    },
    "section": {
      "type": "object",
      "required": [
        "id",
        "title",
        "source",
        "render"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "intro": {
          "type": "string"
        },
        "source": {
          "$ref": "#/$defs/source"
        },
        "render": {
          "$ref": "#/$defs/render"
        },
        "group_by": {
          "$ref": "#/$defs/group_by"
        },
        "presentation_sort": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/sort"
          }
        },
        "empty_message": {
          "type": "string"
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}