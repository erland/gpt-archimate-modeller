{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "test_run"
  ],
  "properties": {
    "test_run": {
      "type": "object",
      "required": [
        "version",
        "status",
        "summary",
        "tests"
      ],
      "properties": {
        "version": {
          "type": "string"
        },
        "status": {
          "enum": [
            "passed",
            "failed",
            "error"
          ]
        },
        "started_at": {
          "type": "string"
        },
        "duration_ms": {
          "type": "integer",
          "minimum": 0
        },
        "summary": {
          "type": "object",
          "required": [
            "total",
            "passed",
            "failed",
            "skipped"
          ],
          "properties": {
            "total": {
              "type": "integer"
            },
            "passed": {
              "type": "integer"
            },
            "failed": {
              "type": "integer"
            },
            "skipped": {
              "type": "integer"
            }
          }
        },
        "tests": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "suite",
              "status",
              "duration_ms"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "suite": {
                "type": "string"
              },
              "status": {
                "enum": [
                  "passed",
                  "failed",
                  "skipped"
                ]
              },
              "duration_ms": {
                "type": "integer"
              },
              "message": {
                "type": "string"
              },
              "details": {}
            }
          }
        }
      }
    }
  }
}