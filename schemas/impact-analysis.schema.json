{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "EA Impact Analysis Request",
  "type": "object",
  "required": [
    "impact_analysis"
  ],
  "additionalProperties": false,
  "properties": {
    "impact_analysis": {
      "type": "object",
      "required": [
        "id",
        "seeds"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^IMP-[A-Z0-9][A-Z0-9_-]*$"
        },
        "title": {
          "type": "string"
        },
        "seeds": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "direction": {
          "type": "string",
          "enum": [
            "outgoing",
            "incoming",
            "both"
          ],
          "default": "both"
        },
        "max_depth": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10,
          "default": 3
        },
        "relationship_types": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "exclude_relationship_types": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "include_seeds": {
          "type": "boolean",
          "default": false
        },
        "stop_types": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "include_paths": {
          "type": "boolean",
          "default": true
        }
      }
    }
  }
}