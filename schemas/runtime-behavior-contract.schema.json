{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/runtime-behavior-contract.schema.json",
  "title": "Runtime Behavior Contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "canonical_instruction",
    "critical_behavior_location",
    "knowledge_may_not_be_required_for_core_behavior",
    "required_markers"
  ],
  "properties": {
    "contract_version": {
      "type": "integer",
      "minimum": 1
    },
    "canonical_instruction": {
      "type": "string",
      "minLength": 1
    },
    "critical_behavior_location": {
      "type": "string",
      "enum": [
        "canonical_instruction"
      ]
    },
    "knowledge_may_not_be_required_for_core_behavior": {
      "type": "boolean"
    },
    "required_markers": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
