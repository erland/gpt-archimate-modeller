{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/query.schema.json",
  "title": "EA Query",
  "type": "object",
  "required": [
    "query"
  ],
  "additionalProperties": false,
  "properties": {
    "query": {
      "type": "object",
      "required": [
        "id",
        "select"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "select": {
          "type": "string",
          "enum": [
            "elements",
            "relationships",
            "sources",
            "references",
            "issues",
            "observations"
          ]
        },
        "where": {
          "$ref": "#/$defs/where"
        },
        "traverse": {
          "$ref": "#/$defs/traverse"
        },
        "return": {
          "$ref": "#/$defs/return"
        },
        "sort": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/sort"
          }
        },
        "limit": {
          "type": "integer",
          "minimum": 1
        },
        "aggregate": {
          "$ref": "#/$defs/aggregate"
        }
      }
    }
  },
  "$defs": {
    "where": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": {
          "type": "string"
        },
        "type_in": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "specialization": {
          "type": "string"
        },
        "id_in": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "name_contains": {
          "type": "string"
        },
        "property_equals": {
          "type": "object"
        },
        "property_in": {
          "type": "object",
          "additionalProperties": {
            "type": "array"
          }
        },
        "evidence_status_in": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "confidence_in": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "source_in": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "target_in": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "status_in": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "priority_in": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "lifecycle_in": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "temporal_status_source_in": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "traverse": {
      "type": "object",
      "required": [
        "direction",
        "depth"
      ],
      "additionalProperties": false,
      "properties": {
        "direction": {
          "type": "string",
          "enum": [
            "outgoing",
            "incoming",
            "both"
          ]
        },
        "relationship_types": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "target_types": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "depth": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10
        },
        "include_start": {
          "type": "boolean",
          "default": false
        }
      }
    },
    "return": {
      "type": "object",
      "required": [
        "fields"
      ],
      "additionalProperties": false,
      "properties": {
        "fields": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        }
      }
    },
    "sort": {
      "type": "object",
      "required": [
        "field"
      ],
      "additionalProperties": false,
      "properties": {
        "field": {
          "type": "string"
        },
        "direction": {
          "type": "string",
          "enum": [
            "asc",
            "desc"
          ],
          "default": "asc"
        }
      }
    },
    "aggregate": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "count": {
          "type": "boolean"
        },
        "group_by": {
          "type": "string"
        }
      }
    }
  }
}